# Dify Cloud
DIFY_BASE_URL=https://api.dify.ai/v1
# 端用户名（分享时每人改成自己的，避免会话与缓存串线）
DIFY_USER_ID=Liu Sheng
# 可选兜底 Key；优先使用请求头里的 app-xxxx
DIFY_API_KEY=

# 代理监听
HOST=127.0.0.1
PORT=7272
# HOST 改为外部地址时，必须设置；用于 /sessions、/usage/reset、/debug 等管理端点
ADMIN_TOKEN=

# 入站请求落盘 data/request_logs/（1=开 0=关）；只保留最近 200 份，其余按时序淘汰
LOG_REQUESTS=1

# 结构化工具出口（默认关；重开条件见 经验.md 的 Backlog）
TOOL_STRUCTURED=0

# 按次计费单价（美元/枪）
OPUS_USD_PER_CALL=1.0
HAIKU_USD_PER_CALL=0.0
